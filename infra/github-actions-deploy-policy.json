{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": [
        "arn:aws:ecr:ap-south-1:119033256221:repository/ai-meeting-assistant-api",
        "arn:aws:ecr:ap-south-1:119033256221:repository/ai-meeting-assistant-worker"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:DescribeTaskDefinition",
        "ecs:RegisterTaskDefinition",
        "ecs:UpdateService"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
      "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::119033256221:role/ai-meeting-assistant-execution-role",
        "arn:aws:iam::119033256221:role/ai-meeting-assistant-task-role"
      ]
    }
  ]
}
